    "client": ["com.ytmusic.ingame.YtMusicClient"]
  },
  "depends": {
    "fabricloader": ">=0.18.1",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*",
    "rinku": ">=3.0.1"
  }
}
